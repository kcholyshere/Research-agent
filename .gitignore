# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# DotEnv configuration
.env

# Database
*.db
*.rdb

# Pycharm
.idea

# VS Code
.vscode/
*.code-workspace

# Spyder
.spyproject/

# Jupyter NB Checkpoints
.ipynb_checkpoints/

# Mac OS-specific storage files
.DS_Store

# vim
*.swp
*.swo

# Mypy cache
.mypy_cache/

# Exclude virtual environment
.venv/

# Exclude trained models
/models/

# exclude data from source control by default
# /data/

# Ingestion pipeline outputs - regenerate via `python -m src.dataset`
data/interim/*.json
data/interim/page_images/
data/interim/colpali_embeddings/
data/processed/*.jsonl

# Raw eval run outputs - regenerate via `python -m src.evaluation.run_eval`.
# Deliberately split from the rest of the eval assets: the question set and the
# replay fixtures under data/eval/ ARE tracked, because they are the deliverable
# and a fixture change must be reviewable in a diff. Individual run outputs are
# regenerable measurement noise and would churn the repo, so a run only enters
# version control when it is promoted by hand into data/eval/baselines/.
data/processed/eval_runs/

# Agent working docs (requirements notes, decision log) - not for version control
/agent_docs/
/references/

# Agent skills installed as environment-specific symlinks (streamlit skills,
# langfuse/skills, etc.) - not portable across machines, don't commit
.claude/skills/
.agents/skills/