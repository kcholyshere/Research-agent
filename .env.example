# Vertex AI via Application Default Credentials (no API keys):
#   gcloud auth application-default login
# GOOGLE_GENAI_USE_VERTEXAI routes ADK/google-genai through Vertex instead of
# an API key.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=gd-gcp-internship-ds
GOOGLE_CLOUD_LOCATION=global

# Tavily, the phase 2 web search provider (src/tools/web_search.py, ADR-0028).
# The only API key this project needs: everything Google is reached through
# Application Default Credentials, and Tavily is not a Google service. Get one
# free (1,000 credits/month, no card) at https://app.tavily.com. Without it,
# web search returns a "not configured" error and the rest of the agent - the
# knowledge base, financial data, the News Agent - still works.
TAVILY_API_KEY=tvly-...

# Langfuse (observability/tracing) - wired in via src/research_agent/agent.py,
# see ADR-0007
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Where the agent finds the two services it depends on. The defaults in
# src/config.py are the localhost forms below and are correct for a local
# checkout talking to `docker compose up -d mcp-fetch news-agent`, so both lines
# can stay commented out. docker-compose.yml overrides them with service names
# for the containers - do not set them here to compose-internal hostnames, or a
# local run will try to resolve them and fail.
#MCP_FETCH_URL=http://localhost:8090/mcp
#NEWS_AGENT_URL=http://localhost:8001
